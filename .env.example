# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DIRECT GMAIL ENQUIRY DELIVERY (Optional — configures authenticated Gmail SMTP)
# Add GMAIL_APP_PASSWORD in AI Studio Secrets (16-character Google App Password)
# to send Consultation Requests and Enquiries directly from Gmail SMTP.
# If omitted, the server automatically falls back to zero-config email forwarding.
ENQUIRY_RECIPIENT_EMAIL="jonathan.tadanki@gmail.com"
GMAIL_USER="jonathan.tadanki@gmail.com"
GMAIL_APP_PASSWORD=""

# ANDROID TWA DIGITAL ASSET LINKS (Google Play Store Publishing)
# Configure your Android applicationId and comma-separated SHA-256 signing certificate fingerprints
# (from Google Play Console -> Setup -> App signing) to serve live at /.well-known/assetlinks.json
ANDROID_TWA_PACKAGE_NAME="com.arshiel.assurance.twa"
ANDROID_TWA_SHA256_FINGERPRINTS=""
